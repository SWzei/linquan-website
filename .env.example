# Backend
TZ=UTC
HOST=0.0.0.0
PORT=4000
JWT_SECRET=replace-with-strong-secret
DATABASE_URL=
DB_PATH=../database/linquan.db
UPLOAD_ROOT=uploads
# Upload safety defaults (bytes)
MAX_UPLOAD_REQUEST_BYTES=67108864
MIN_UPLOAD_FREE_BYTES=268435456
# Alibaba ECS production template:
# deploy/aliyun/.env.backend.aliyun.example
# Existing process variables override .env. A non-empty DATABASE_URL always selects PostgreSQL.
# Only when DATABASE_URL is empty does SQLite use DB_PATH; relative paths resolve from backend cwd.
# On Render free plan, local uploads are ephemeral. Use object storage for long-term files.
SERVE_FRONTEND=true
# Leave empty in local dev. In production, set exact origins separated by comma.
# Example: ALLOWED_ORIGINS=https://linquan-website.onrender.com
ALLOWED_ORIGINS=

# Optional SMTP (notification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NJU林泉钢琴社 <no-reply@example.com>"
