{
  "name": "linquan-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "node scripts/patch-deprecated-deps.cjs",
    "serve": "node scripts/patch-deprecated-deps.cjs && vue-cli-service serve",
    "build": "node scripts/patch-deprecated-deps.cjs && vue-cli-service build",
    "lint": "node scripts/patch-deprecated-deps.cjs && vue-cli-service lint",
    "test:authenticated-files": "node scripts/authenticatedFilesValidation.mjs",
    "test:auth-ui-state": "node scripts/authUiStateValidation.mjs"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@vue/cli-plugin-babel": "~5.0.9",
    "@vue/cli-plugin-eslint": "~5.0.9",
    "@vue/cli-service": "~5.0.9",
    "@vue/compiler-sfc": "^3.5.13",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0"
  }
}
